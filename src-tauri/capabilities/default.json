{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets the forge pick an output folder and write images into it.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }]
    },
    "dialog:default",
    "dialog:allow-open",
    "shell:allow-open"
  ]
}
